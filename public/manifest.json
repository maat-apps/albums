{
  "name": "Albums",
  "short_name": "Albums",
  "description": "The albums you've listened to, kept on your device.",
  "start_url": "/albums/",
  "scope": "/albums/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "share_target": {
    "action": "/albums/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "backup",
          "accept": ["application/json", ".json", "text/plain", ".txt"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/albums/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/albums/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/albums/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/albums/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
